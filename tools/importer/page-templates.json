          "section": "secondary"
        },
        {
          "name": "section-gallery",
          "instances": [
            "#main-content > section.section.secondary-section:nth-of-type(2)"
          ],
          "section": "secondary"
        },
        {
          "name": "section-articles",
          "instances": [
            "#main-content > section.section.secondary-section:nth-of-type(4)"
          ],
          "section": "secondary"
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero header",
          "selector": "#main-content > header.section.secondary-section",
          "style": "secondary",
          "blocks": [
            "hero-header"
