          "defaultContent": [
            "#main-content > section.section:nth-of-type(5) h2.h2-heading",
            "#main-content > section.section:nth-of-type(5) p.paragraph-lg"
          ]
        },
        {
          "id": "section-7",
          "name": "CTA",
          "selector": "#main-content > section.section.inverse-section",
          "style": null,
          "blocks": [
            "hero-cta"
