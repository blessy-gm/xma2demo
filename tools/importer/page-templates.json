          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Image gallery",
          "selector": "#main-content > section.section.secondary-section:nth-of-type(2)",
          "style": "secondary",
          "blocks": [
            "cards-gallery"
          ],
          "defaultContent": [
